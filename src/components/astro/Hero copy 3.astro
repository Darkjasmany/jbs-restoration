---
import { SERVICE_OPTIONS } from "../../lib/services";
import type { SiteConfig } from "../../lib/types";
import { displayPhone, toTel } from "../../lib/utils";
import { ContactForm } from "../react/public/ContactForm";

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const hasVideo = config.hero_type === "video" && !!config.hero_video_url;
const telHref = toTel(config.phone);
---

<section
  class="relative isolate flex min-h-[85vh] items-center overflow-hidden bg-ink-900 text-white pt-16 pb-20 lg:py-28"
  aria-labelledby="hero-title"
>
  {
    config.hero_poster_url && (
      <img
        src={config.hero_poster_url}
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
    )
  }
  {
    hasVideo && (
      <video
        data-hero-src={config.hero_video_url}
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 -z-10 h-full w-full object-cover opacity-0 transition-opacity duration-700 motion-reduce:hidden"
      />
    )
  }

  <div
    class="absolute inset-0 -z-[5] bg-gradient-to-t from-ink-900/95 via-ink-900/75 to-ink-900/50"
    aria-hidden="true"
  >
  </div>

  {/* Contenedor principal expandido a max-w-7xl para pantallas grandes */}

  <div
    class="mx-auto grid w-full max-w-7xl gap-12 px-6 lg:px-10 lg:grid-cols-12 lg:items-center"
  >
    {/* Columna Izquierda (7 espacios): Textos solicitados */}
    <div class="lg:col-span-7 space-y-6">
      <h1
        id="hero-title"
        class="text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.05] tracking-tight"
      >
        The Difference Is in <span class="text-gold-500">The Details</span>
      </h1>

      <p
        class="max-w-xl text-lg sm:text-xl leading-relaxed text-slate-300 font-normal"
      >
        Professional Roofing, Siding and Restoration Services. Building
        Confidence Into Every Project.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a
          href="/contact"
          class="rounded-lg bg-gold-500 px-7 py-3.5 font-extrabold uppercase tracking-wider text-ink-900 transition-transform hover:bg-gold-400 active:scale-95 shadow-lg"
        >
          Get a Free Estimate
        </a>
        {
          telHref && (
            <a
              href={telHref}
              class="rounded-lg border-2 border-white/60 px-7 py-3.5 font-bold text-white transition hover:bg-white/10"
            >
              Call {displayPhone(config.phone!)}
            </a>
          )
        }
      </div>
    </div>

    {/* Columna Derecha (5 espacios): Formulario Flotante limpio */}

    <div class="lg:col-span-5">
      <div
        class="rounded-2xl bg-white p-6 sm:p-8 text-ink-900 shadow-2xl border border-slate-100"
      >
        <p class="text-2xl font-black leading-tight">
          Get Your Free <span class="text-gold-600">Roof Estimate</span>
        </p>
        <p class="mt-1 text-sm text-slate-600">
          No obligation. We'll call you back the same day.
        </p>
        <div class="mt-5">
          <ContactForm
            client:visible
            compact
            services={SERVICE_OPTIONS}
            whatsappNumber={config.whatsapp_number}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>(
    "video[data-hero-src]",
  );
  const connection = (
    navigator as Navigator & { connection?: { saveData?: boolean } }
  ).connection;
  const canPlay =
    matchMedia("(min-width: 768px)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    !connection?.saveData;

  if (video && canPlay) {
    video.addEventListener(
      "playing",
      () => video.classList.remove("opacity-0"),
      { once: true },
    );
    video.src = video.dataset.heroSrc ?? "";
    video.play().catch(() => {});
  }
</script>

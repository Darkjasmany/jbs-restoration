---
import type { SiteConfig } from "../../lib/types";
import { displayPhone, toTel } from "../../lib/utils";

interface Props {
  config: SiteConfig;
  overlay?: boolean;
}

const { config, overlay = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const tel = toTel(config.phone);
const hasUtilityBar = Boolean(config.phone || config.email || config.address);

// Separación limpia del nombre
const words = config.company_name.trim().split(" ");
const name1 = words[0] || "";
const name2 = words.slice(1).join(" ");
---

<header
  class:list={[
    overlay
      ? "absolute inset-x-0 top-0 z-40 text-white"
      : "relative z-40 border-b border-ink-900/10 bg-white text-ink-900",
  ]}
>
  {/* Barra superior de utilidad */}
  {
    hasUtilityBar && (
      <div
        class:list={[
          "hidden md:block",
          overlay
            ? "border-b border-white/15 bg-ink-900/40"
            : "border-b border-ink-900/10 bg-ink-900",
        ]}
      >
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-2 text-xs font-medium text-white/85">
          <div class="flex items-center gap-6">
            {config.phone && (
              <a
                href={tel!}
                class="flex items-center gap-1.5 hover:text-white transition-colors"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {displayPhone(config.phone)}
              </a>
            )}
            {config.email && (
              <a
                href={`mailto:${config.email}`}
                class="flex items-center gap-1.5 hover:text-white transition-colors"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-10 6L2 7" />
                </svg>
                {config.email}
              </a>
            )}
          </div>
          {config.address && (
            <span class="hidden lg:flex items-center gap-1.5 text-white/70">
              <svg
                viewBox="0 0 24 24"
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              {config.address}
            </span>
          )}
        </div>
      </div>
    )
  }

  {/* Header Principal */}
  <div
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-10"
  >
    <!-- Logo & Brand Name (Estilo JLP Pro Services) -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/favicon.png"
        alt={config.company_name}
        width="44"
        height="44"
        class="rounded-lg object-contain"
      />
      <span class="text-2xl font-extrabold leading-none tracking-tight">
        {config.company_name}
      </span>
    </a>

    <!-- Navegación Central -->
    <nav
      class="hidden items-center gap-8 text-base font-bold md:flex"
      aria-label="Main Navigation"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "underline-offset-8 hover:underline transition-colors",
              isActive(item.href) &&
                "underline decoration-2 decoration-gold-500",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Botón Acción "CLICK TO CALL" -->
    <div class="flex items-center gap-4">
      {
        tel && (
          <a
            href={tel}
            class="hidden items-center gap-2 rounded-lg bg-gold-500 px-5 py-2.5 text-xs font-black uppercase tracking-wider text-ink-900 transition hover:bg-gold-400 md:inline-flex shadow-sm"
          >
            <svg
              viewBox="0 0 24 24"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            Click to Call
          </a>
        )
      }

      <!-- Menú Hamburguesa para Móvil -->
      <details class="relative md:hidden">
        <summary
          class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold ring-1 ring-inset ring-ink-900/30 [&::-webkit-details-marker]:hidden"
        >
          Menu
        </summary>
        <nav
          class="absolute right-0 top-full mt-2 w-64 rounded-xl bg-ink-900 p-2 text-white shadow-xl z-50"
          aria-label="Mobile"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-lg px-4 py-3 font-medium hover:bg-white/10"
              >
                {item.label}
              </a>
            ))
          }
          {
            tel && (
              <a
                href={tel}
                class="mt-1 block rounded-lg bg-gold-500 px-4 py-3 text-center font-extrabold uppercase tracking-wide text-ink-900"
              >
                Call {displayPhone(config.phone!)}
              </a>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>

---
interface Props {
  gradient?: boolean;
  bottomFade?: boolean;
}

const { gradient = true, bottomFade = true } = Astro.props;
---

<!-- GRADIENTE INVERTIDO: Claro a la izquierda, oscuro a la derecha --><!-- MAS OSCURO --><!-- <div
    class="absolute inset-0 -z-[5] bg-gradient-to-r from-transparent via-[#3c0f19]/40 via-40% to-[#2b0a11]/95"
    aria-hidden="true"
  >
  </div> -->
<div
  class="pointer-events-none absolute inset-0 -z-[5] bg-gradient-to-r from-[#2b0a11]/10 via-[#3c0f19]/30 via-45% to-[#3c0f19]/65"
  aria-hidden="true"
  hidden={!gradient}
>
</div>

{/* Sombra inferior suave */}
<!-- <div
    class="absolute inset-x-0 bottom-0 h-24 -z-[4] bg-gradient-to-t from-[#2b0a11]/90 to-transparent"
    aria-hidden="true"
  >
  </div> -->
<div
  class="pointer-events-none absolute inset-x-0 bottom-0 -z-[4] h-20 bg-gradient-to-t from-[#2b0a11]/55 to-transparent"
  aria-hidden="true"
  hidden={!bottomFade}
>
</div>

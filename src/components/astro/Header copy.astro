---
import Image from "astro:assets";
import type { SiteConfig } from "../../lib/types";

interface Props {
  config: SiteConfig;
  overlay?: boolean;
}

const { config, overlay = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const tel = config.phone ? `tel:${config.phone.replace(/[^\d+]/g, "")}` : null;

const words = config.company_name.trim().split(" ");
const name1 = words[0] || " ";
const name2 = words.slice(1).join(" ");
---

<header
  class:list={[
    overlay
      ? "absolute inset-x-0 top-0 z-40 text-white"
      : "relative z-40 border-b border-slate-200 bg-white text-ink-900",
  ]}
>
  <!-- class="mx-auto flex h-20 max-w-6xl items-center justify-between gap-6 px-6" -->
  <div
    class="mx-auto flex h-40 max-w-6xl items-center justify-between gap-6 px-6"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 text-5xl font-extrabold tracking-tight"
    >
      <div class="flex align-center items-center">
        <img
          src="/favicon.png"
          alt=""
          width="180"
          height="180"
          class="rounded-md"
        />
        <div class="flex flex-col text-5xl font-extrabold tracking-tight">
          <span>{name1}</span>
          <span>{name2}</span>
        </div>
        <!-- {config.company_name} -->
      </div>
    </a>
    <!-- <a
      href="/"
      class="flex items-center gap-2.5 text-5xl font-extrabold tracking-tight"
    >
      <img
        src="/favicon.png"
        alt=""
        width="100"
        height="100"
        class="rounded-md"
      />
      {config.company_name}
    </a> -->

    <nav
      class="hidden items-center gap-8 text-sm font-semibold md:flex"
      aria-label="Main"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "underline-offset-8 hover:underline",
              isActive(item.href) &&
                "underline decoration-2 decoration-brand-500",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      {
        tel && (
          <a
            href={tel}
            class:list={[
              "hidden rounded-lg px-4 py-2 text-sm font-semibold lg:inline-block",
              overlay
                ? "border border-white/50 hover:bg-white/10"
                : "bg-ink-900 text-white hover:bg-ink-800",
            ]}
          >
            {config.phone}
          </a>
        )
      }
      <details class="relative md:hidden">
        <summary
          class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold ring-1 ring-inset ring-slate-400/60 [&::-webkit-details-marker]:hidden"
          >Menu</summary
        >
        <nav
          class="absolute right-0 top-full mt-2 w-60 rounded-xl bg-ink-900 p-2 text-white shadow-xl"
          aria-label="Mobile"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-lg px-4 py-3 font-medium hover:bg-white/10"
              >
                {item.label}
              </a>
            ))
          }
          {
            tel && (
              <a
                href={tel}
                class="mt-1 block rounded-lg bg-brand-600 px-4 py-3 text-center font-semibold"
              >
                Call {config.phone}
              </a>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>

---
import { SERVICE_OPTIONS } from "../../lib/services";
import type { SiteConfig } from "../../lib/types";
import { displayPhone, toTel } from "../../lib/utils";
import { ContactForm } from "../react/public/ContactForm";
import HeroOverlay from "./HeroOverlay.astro";

interface Props {
  config: SiteConfig;
}

const { config } = Astro.props;
const hasVideo = config.hero_type === "video" && !!config.hero_video_url;
const telHref = toTel(config.phone);
---

<section
  class="relative isolate flex min-h-screen items-center overflow-hidden bg-[#2b0a11] text-white pt-32 pb-20 md:pt-40 lg:pb-28 border-t border-[#561724]"
  aria-labelledby="hero-title"
>
  {/* 1. FOTO DE FONDO */}
  {
    config.hero_poster_url && (
      <img
        src={config.hero_poster_url}
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
      />
    )
  }

  {/* 2. VIDEO DE FONDO */}
  {
    hasVideo && (
      <video
        data-hero-src={config.hero_video_url}
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 -z-10 h-full w-full object-cover opacity-0 transition-opacity duration-700 motion-reduce:hidden"
      />
    )
  }

  {/* 3. GRADIENTE INVERTIDO */}
  <HeroOverlay />

  {/* 4. CONTENIDO PRINCIPAL */}
  <div
    class="mx-auto grid w-full max-w-7xl gap-12 px-6 lg:px-10 lg:grid-cols-12 lg:items-center relative z-10"
  >
    {
      /* Columna Izquierda: Textos con sombra ligera para destacar sobre la imagen clara */
    }
    <div class="lg:col-span-7 space-y-6">
      <h1
        id="hero-title"
        class="text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.08] tracking-tight drop-shadow-md"
      >
        The Difference Is in <span class="text-[#bf9e6a]">The Details</span>
      </h1>

      <p
        class="max-w-xl text-lg sm:text-xl leading-relaxed text-slate-100 font-normal drop-shadow"
      >
        Professional Roofing, Siding and Restoration Services. Building
        Confidence Into Every Project.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a
          href="/contact"
          class="rounded-lg bg-[#bf9e6a] px-7 py-3.5 font-extrabold uppercase tracking-wider text-[#3c0f19] transition-all hover:bg-[#d2b687] active:scale-95 shadow-xl hover:shadow-[#bf9e6a]/20"
        >
          Get a Free Estimate
        </a>
        {
          telHref && (
            <a
              href={telHref}
              class="rounded-lg border-2 border-white/70 bg-[#3c0f19]/30 backdrop-blur-xs px-7 py-3.5 font-bold text-white transition hover:bg-white/20 shadow-md"
            >
              Call {displayPhone(config.phone!)}
            </a>
          )
        }
      </div>
    </div>

    {/* Columna Derecha: Formulario de estimación */}
    <div class="lg:col-span-5">
      <div
        class="relative overflow-hidden rounded-2xl border border-white/70 bg-white p-6 text-[#3c0f19] shadow-[0_24px_80px_rgba(20,0,6,0.28)] sm:p-8"
      >
        <!-- Acento dorado superior -->
        <!-- <div
          class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#7d6440] via-[#bf9e6a] to-[#d2b687]"
          aria-hidden="true"
        >
        </div> -->

        <div class="flex items-start gap-4">
          <div class="min-w-0 flex-1">
            <p
              class="text-2xl font-black leading-tight tracking-tight sm:text-[1.75rem]"
            >
              Get Your Free {" "}
              <span class="text-[#a3834f]">Roof Estimate</span>
            </p>

            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              Tell us about your project. We'll help you figure out the next
              step.
            </p>
          </div>

          <!-- Icono decorativo -->
          <div
            class="hidden h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#f8f2e8] text-[#a3834f] sm:flex"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m3 11 9-8 9 8"></path>
              <path d="M5 10v10h14V10"></path>
              <path d="M9 20v-6h6v6"></path>
            </svg>
          </div>
        </div>

        <div class="my-5 h-px bg-slate-100"></div>

        <ContactForm
          client:visible
          compact
          services={SERVICE_OPTIONS}
          whatsappNumber={config.whatsapp_number}
        />

        <div
          class="mt-5 flex items-start gap-3 rounded-xl bg-[#faf7f2] px-4 py-3"
        >
          <svg
            viewBox="0 0 24 24"
            class="mt-0.5 h-5 w-5 shrink-0 text-[#a3834f]"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
          <div>
            <p class="text-sm font-bold text-[#3c0f19]">
              No pressure. Just a conversation.
            </p>
            <p class="mt-1 text-xs leading-relaxed text-slate-600">
              Share a few details and we'll help you understand your options.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>(
    "video[data-hero-src]",
  );
  const connection = (
    navigator as Navigator & { connection?: { saveData?: boolean } }
  ).connection;
  const canPlay =
    matchMedia("(min-width: 768px)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    !connection?.saveData;

  if (video && canPlay) {
    video.addEventListener(
      "playing",
      () => video.classList.remove("opacity-0"),
      { once: true },
    );
    video.src = video.dataset.heroSrc ?? "";
    video.play().catch(() => {});
  }
</script>

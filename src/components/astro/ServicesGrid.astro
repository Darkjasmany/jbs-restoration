---
import type { Service } from '../../lib/types';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

{
  services.length > 0 ? (
    <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <li>
          <a href={`/services/${s.slug}`} class="group block">
            <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-100 ring-1 ring-slate-200">
              {s.image_url ? (
                <img
                  src={s.image_url}
                  alt={s.image_alt ?? s.name}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                />
              ) : (
                <span class="flex h-full w-full items-center justify-center text-sm text-slate-400">Photo coming soon</span>
              )}
            </div>
            <h2 class="mt-4 text-xl font-bold transition group-hover:text-brand-600">{s.name}</h2>
            {s.short_description && <p class="mt-2 text-slate-600">{s.short_description}</p>}
            <span class="mt-3 inline-block font-semibold text-brand-700 underline underline-offset-4">Learn more</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="rounded-xl bg-slate-50 p-8 text-slate-600">Services are coming soon.</p>
  )
}

---
import type { SiteConfig } from "../../lib/types";
import { displayPhone, toTel } from "../../lib/utils";

interface Props {
  config: SiteConfig;
  overlay?: boolean;
}

const { config, overlay = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const tel = toTel(config.phone);
const hasUtilityBar = Boolean(config.phone || config.email || config.address);

// Separación limpia del nombre
const words = config.company_name.trim().split(" ");
const name1 = words[0] || "";
const name2 = words.slice(1).join(" ");
---

<header
  class:list={[
    overlay
      ? "absolute inset-x-0 top-0 z-40 text-white"
      : "relative z-40 border-b border-ink-900/10 bg-white text-ink-900",
  ]}
>
  {/* Barra superior de utilidad */}
  {
    hasUtilityBar && (
      <div class="hidden md:block border-b border-[#561724] bg-[#2b0a11]">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-2 text-xs font-medium text-white/85">
          <div class="flex items-center gap-6">
            {config.phone && (
              <a
                href={tel!}
                class="flex items-center gap-1.5 hover:text-[#bf9e6a] transition-colors"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
                {displayPhone(config.phone)}
              </a>
            )}
            {config.email && (
              <a
                href={`mailto:${config.email}`}
                class="flex items-center gap-1.5 hover:text-[#bf9e6a] transition-colors"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m22 7-10 6L2 7" />
                </svg>
                {config.email}
              </a>
            )}
          </div>
        </div>
      </div>
    )
  }

  {/* Header Principal */}
  <div
    class="mx-auto flex h-24 max-w-7xl items-center justify-between px-6 lg:px-10"
  >
    <!-- Logo basado en la Tarjeta de Presentación -->
    <a href="/" class="flex items-center gap-3.5 group">
      {/* Isotipo / Favicon con fondo dorado o transparente */}
      <!-- class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-[#d2b687] to-[#bf9e6a] p-2 shadow-inner" -->
      <div
        class="flex h-12 w-12 items-center justify-center rounded-xl p-2 shadow-inner"
      >
        <img
          src="/favicon.png"
          alt={config.company_name}
          width="400"
          height="200"
          class="h-full w-full object-contain"
        />
      </div>

      {/* Texto apilado exacto a la tarjeta: JBS + RESTORATION */}
      <div class="flex flex-col justify-center leading-none select-none">
        <span
          class="text-3xl font-black tracking-tight text-[#fbeef0] drop-shadow-sm"
        >
          {name1}
        </span>
        {
          name2 && (
            <span class="text-[10px] font-extrabold tracking-[0.28em] text-[#bf9e6a] uppercase mt-1">
              {name2}
            </span>
          )
        }
      </div>
    </a>

    <!-- Navegación Central -->
    <nav
      class="hidden items-center gap-8 text-base font-bold md:flex"
      aria-label="Main Navigation"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-[#bf9e6a]",
              isActive(item.href)
                ? "text-[#bf9e6a] underline decoration-2 decoration-[#bf9e6a] underline-offset-8"
                : "text-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Botón Acción "CLICK TO CALL" -->
    <div class="flex items-center gap-4">
      {
        tel && (
          <a
            href={tel}
            class="hidden items-center gap-2 rounded-lg bg-[#bf9e6a] px-5 py-2.5 text-xs font-black uppercase tracking-wider text-[#3c0f19] transition hover:bg-[#d2b687] md:inline-flex shadow-sm"
          >
            <svg
              viewBox="0 0 24 24"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            Click to Call
          </a>
        )
      }

      <!-- Menú Hamburguesa para Móvil -->
      <details class="relative md:hidden">
        <summary
          class="cursor-pointer list-none rounded-lg bg-[#4a1420] px-3 py-2 text-sm font-semibold text-white ring-1 ring-white/20"
        >
          Menu
        </summary>
        <nav
          class="absolute right-0 top-full mt-2 w-64 rounded-xl bg-[#3c0f19] p-2 text-white shadow-xl z-50 border border-[#561724]"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-lg px-4 py-3 font-medium hover:bg-white/10"
              >
                {item.label}
              </a>
            ))
          }
          {
            tel && (
              <a
                href={tel}
                class="mt-1 block rounded-lg bg-[#bf9e6a] px-4 py-3 text-center font-extrabold uppercase tracking-wide text-[#3c0f19]"
              >
                Call {displayPhone(config.phone!)}
              </a>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>

---
import type { SiteConfig } from "../../lib/types";
import { displayPhone, toTel } from "../../lib/utils";
import UtilityBar from "./UtilityBar.astro";

interface Props {
  config: SiteConfig;
  overlay?: boolean;
}

const { config, overlay = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const tel = toTel(config.phone);

const words = config.company_name.trim().split(" ");
const name1 = words[0] || "";
const name2 = words.slice(1).join(" ");
---

<header
  id="site-header"
  data-overlay={overlay ? "true" : "false"}
  class:list={[
    "z-50 w-full transition-[background-color,box-shadow,border-color] duration-300 ease-out",
    overlay
      ? "absolute inset-x-0 top-0 bg-transparent text-white"
      : "sticky top-0 border-b border-ink-900/10 bg-white text-ink-900",
  ]}
>
  <!-- <header
  id="site-header"
  data-overlay={overlay ? "true" : "false"}
  class:list={[
    "z-50 w-full transition-[background-color,box-shadow,border-color] duration-300 ease-in-out",
    overlay
      ? "absolute inset-x-0 top-0 text-white"
      : "sticky top-0 border-b border-ink-900/10 bg-white text-ink-900",
  ]}
> -->
  {/* Barra superior de utilidad */}
  <div
    id="utility-bar"
    class="overflow-hidden opacity-100 transition-[max-height,opacity] duration-500 ease-in-out"
    style="max-height: 200px"
  >
    <UtilityBar config={config} />
  </div>

  {/* Header Principal */}
  <div
    id="header-main"
    class="mx-auto flex h-24 max-w-7xl items-center justify-between px-6 lg:px-10"
  >
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2">
      <img
        src="/favicon.png"
        alt=""
        width="51"
        height="56"
        class="h-14 w-auto shrink-0 object-contain"
      />

      {/* Texto apilado JBS + RESTORATION */}
      <div class="flex flex-col justify-center leading-none select-none">
        <span
          class="text-3xl font-black tracking-tight text-[#fbeef0] drop-shadow-sm"
        >
          {name1}
        </span>
        {
          name2 && (
            <span class="text-[11px] font-extrabold tracking-[0.28em] text-[#bf9e6a] uppercase mt-1">
              {name2}
            </span>
          )
        }
      </div>
    </a>

    <!-- Navegación de escritorio -->
    <nav
      class="hidden items-center gap-8 text-base font-bold md:flex"
      aria-label="Main Navigation"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-[#bf9e6a]",
              isActive(item.href)
                ? "text-[#bf9e6a] underline decoration-2 decoration-[#bf9e6a] underline-offset-8"
                : "text-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Botón Acción "CLICK TO CALL" -->
    <div class="flex items-center gap-4">
      {
        tel && (
          <a
            href={tel}
            class="hidden items-center gap-2 rounded-lg bg-[#bf9e6a] px-5 py-2.5 text-xs font-black uppercase tracking-wider text-[#3c0f19] transition hover:bg-[#d2b687] md:inline-flex shadow-sm"
          >
            <svg
              viewBox="0 0 24 24"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            Click to Call
          </a>
        )
      }

      <!-- Menú Móvil -->
      <details class="relative md:hidden">
        <summary
          class="cursor-pointer list-none rounded-lg bg-[#4a1420] px-3 py-2 text-sm font-semibold text-white ring-1 ring-white/20"
        >
          Menu
        </summary>
        <nav
          class="absolute right-0 top-full mt-2 w-64 rounded-xl bg-[#3c0f19] p-2 text-white shadow-xl z-50 border border-[#561724]"
          aria-label="Mobile Navigation"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "block rounded-lg px-4 py-3 font-medium hover:bg-white/10",
                  isActive(item.href) && "text-[#bf9e6a]",
                ]}
                class="block rounded-lg px-4 py-3 font-medium hover:bg-white/10"
              >
                {item.label}
              </a>
            ))
          }
          {
            tel && (
              <a
                href={tel}
                class="mt-1 block rounded-lg bg-[#bf9e6a] px-4 py-3 text-center font-extrabold uppercase tracking-wide text-[#3c0f19]"
              >
                Call {displayPhone(config.phone!)}
              </a>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const initHeader = () => {
    const header = document.querySelector<HTMLElement>("#site-header");
    const utilityBar = document.querySelector<HTMLElement>("#utility-bar");

    if (!header || !utilityBar) return;

    const isOverlay = header.dataset.overlay === "true";
    let ticking = false;
    let lastScrolled: boolean | null = null;

    const updateHeader = () => {
      const scrollY = window.scrollY;
      const isScrolled = scrollY > 20;

      // Progreso suave del color entre 20 y 180 px.
      const progress = Math.min(1, Math.max(0, (scrollY - 20) / 160));

      // UtilityBar solo cambia cuando cruzamos el umbral.
      if (lastScrolled !== isScrolled) {
        lastScrolled = isScrolled;

        utilityBar.style.maxHeight = isScrolled
          ? "0px"
          : `${utilityBar.scrollHeight}px`;

        utilityBar.style.opacity = isScrolled ? "0" : "1";
        utilityBar.style.pointerEvents = isScrolled ? "none" : "";
      }

      // Posición del header.
      header.classList.remove("absolute", "sticky", "fixed");

      if (isScrolled) {
        header.classList.add("fixed", "inset-x-0", "top-0");
      } else if (isOverlay) {
        header.classList.add("absolute", "inset-x-0", "top-0");
      } else {
        header.classList.add("sticky", "top-0");
      }

      // Transición progresiva del cristal color vino.
      const alpha = 0.88 * progress;

      header.style.backgroundColor = isScrolled
        ? `rgba(60, 15, 25, ${alpha})`
        : "";

      header.style.backdropFilter = isScrolled
        ? `blur(${14 * progress}px)`
        : "";

      header.style.setProperty(
        "-webkit-backdrop-filter",
        isScrolled ? `blur(${14 * progress}px)` : "",
      );

      header.style.boxShadow = isScrolled
        ? `0 8px 28px rgba(20, 0, 6, ${0.22 * progress})`
        : "";

      header.style.borderBottom = isScrolled
        ? `1px solid rgba(255, 255, 255, ${0.12 * progress})`
        : "";

      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;

      ticking = true;
      window.requestAnimationFrame(updateHeader);
    };

    // Estado inicial.
    utilityBar.style.maxHeight = `${utilityBar.scrollHeight}px`;
    updateHeader();

    window.addEventListener("scroll", onScroll, { passive: true });

    window.addEventListener("resize", () => {
      if (window.scrollY <= 20) {
        utilityBar.style.maxHeight = `${utilityBar.scrollHeight}px`;
      }
      updateHeader();
    });
  };

  initHeader();
</script>

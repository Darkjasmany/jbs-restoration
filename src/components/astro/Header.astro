---
import type { SiteConfig } from "../../lib/types";

interface Props {
  config: SiteConfig;
  overlay?: boolean;
}

const { config, overlay = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/about", label: "About" },
  { href: "/services", label: "Services", hasDropdown: true },
  { href: "/portfolio", label: "Projects" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
const tel = config.phone ? `tel:${config.phone.replace(/[^\d+]/g, "")}` : null;

// Separación limpia del nombre
const words = config.company_name.trim().split(" ");
const name1 = words[0] || "";
const name2 = words.slice(1).join(" ");
---

<header
  class:list={[
    "w-full z-50 transition-colors duration-200",
    overlay
      ? "absolute inset-x-0 top-0 bg-black/90 text-white"
      : "relative border-b border-slate-200 bg-white text-slate-900",
  ]}
>
  <div
    class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-10"
  >
    <!-- Logo & Brand Name (Estilo JLP Pro Services) -->
    <a href="/" class="flex items-center gap-3 group">
      <!-- Isotipo/Favicon -->
      <img
        src="/favicon.png"
        alt={config.company_name}
        class="h-12 w-auto object-contain rounded-sm"
      />

      <!-- Tipografía dividida exactamente como el ejemplo -->
      <div class="flex flex-col justify-center leading-none">
        <span class="text-3xl font-black tracking-tight text-white uppercase">
          {name1}
        </span>
        {
          name2 && (
            <span class="text-[11px] font-bold tracking-widest text-slate-300 uppercase mt-0.5">
              {name2}
            </span>
          )
        }
      </div>
    </a>

    <!-- Navegación Central -->
    <nav
      class="hidden items-center gap-8 text-base font-bold md:flex"
      aria-label="Main Navigation"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "flex items-center gap-1.5 transition-colors hover:text-amber-400",
              isActive(item.href) ? "text-amber-400" : "text-white",
            ]}
          >
            {item.label}
            {item.hasDropdown && (
              <svg class="w-4 h-4 fill-current opacity-80" viewBox="0 0 20 20">
                <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
              </svg>
            )}
          </a>
        ))
      }
    </nav>

    <!-- Botón Acción "CLICK TO CALL" -->
    <div class="flex items-center gap-4">
      {
        tel && (
          <a
            href={tel}
            class="hidden rounded bg-amber-500 px-6 py-2.5 text-xs font-extrabold uppercase tracking-wider text-black shadow transition-transform hover:bg-amber-400 active:scale-95 md:inline-block"
          >
            Click to Call
          </a>
        )
      }

      <!-- Menú Hamburguesa para Móvil -->
      <details class="relative md:hidden">
        <summary
          class="cursor-pointer list-none rounded bg-zinc-800 px-3 py-2 text-xs font-bold uppercase text-white ring-1 ring-zinc-700 [&::-webkit-details-marker]:hidden"
        >
          Menu
        </summary>
        <nav
          class="absolute right-0 top-full mt-2 w-56 rounded-md bg-zinc-900 p-3 text-white shadow-2xl ring-1 ring-zinc-800"
          aria-label="Mobile Navigation"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-md px-4 py-2.5 text-sm font-semibold hover:bg-zinc-800"
              >
                {item.label}
              </a>
            ))
          }
          {
            tel && (
              <a
                href={tel}
                class="mt-2 block rounded bg-amber-500 px-4 py-2.5 text-center text-xs font-black uppercase text-black"
              >
                Click to Call
              </a>
            )
          }
        </nav>
      </details>
    </div>
  </div>
</header>

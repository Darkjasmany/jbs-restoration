---
import type { SiteConfig } from '../../lib/types';

interface Props {
  config: SiteConfig;
  service?: string;
  heading?: string;
}

const { config, service, heading = 'Ready for a straight answer about your roof?' } = Astro.props;
const tel = config.phone ? `tel:${config.phone.replace(/[^\d+]/g, '')}` : null;
const href = service ? `/contact?service=${service}` : '/contact';
---

<section class="bg-ink-900 text-white">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-16 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">{heading}</h2>
      <p class="mt-3 text-white/75">Tell us what you are seeing. We will schedule an inspection and give you a written estimate.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={href} class="rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white transition hover:bg-brand-500">{config.hero_cta_label}</a>
      {tel && <a href={tel} class="rounded-lg border border-gold-500 px-6 py-3 font-semibold text-gold-400 transition hover:bg-gold-500 hover:text-ink-900">Call {config.phone}</a>}
    </div>
  </div>
</section>

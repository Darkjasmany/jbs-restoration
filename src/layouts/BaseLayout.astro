---
import "../styles/global.css";
import SEO from "../components/astro/SEO.astro";

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  noindex?: boolean;
  jsonLd?: object[];
}

const seo = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <SEO {...seo} />
    <slot name="head" />
  </head>
  <body class="bg-white font-sans text-ink-900 antialiased">
    <slot />
  </body>
</html>

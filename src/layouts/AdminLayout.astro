---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: '/admin', label: 'Overview', active: path === '/admin' },
  { href: '/admin/projects', label: 'Projects', active: path.startsWith('/admin/projects') },
  { href: '/admin/testimonials', label: 'Testimonials', active: path === '/admin/testimonials' },
  { href: '/admin/settings', label: 'Site settings', active: path === '/admin/settings' },
];
---

<BaseLayout title={`${title} | Admin`} noindex>
  <div class="min-h-screen bg-slate-50">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
        <nav class="flex flex-wrap gap-1 text-sm font-medium" aria-label="Admin">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={l.active ? 'page' : undefined}
              class:list={['rounded-md px-3 py-2', l.active ? 'bg-ink-900 text-white' : 'text-slate-700 hover:bg-slate-100']}
            >
              {l.label}
            </a>
          ))}
        </nav>
        <form method="post" action="/api/auth/logout">
          <button type="submit" class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Sign out</button>
        </form>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8">
      <h1 class="mb-6 text-2xl font-bold">{title}</h1>
      <slot />
    </main>
  </div>
</BaseLayout>

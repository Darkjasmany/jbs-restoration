---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import { getSiteConfig } from "../lib/queries";
import { localBusinessLd } from "../lib/seo";
import type { SiteConfig } from "../lib/types";

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  jsonLd?: object[];
  config?: SiteConfig;
  overlay?: boolean;
}

const { config: provided, overlay = false, jsonLd = [], ...seo } = Astro.props;
const config = provided ?? (await getSiteConfig(Astro.locals.supabase));
const structured = [localBusinessLd(config, Astro.site!), ...jsonLd];
---

<BaseLayout
  {...seo}
  image={seo.image ?? config.hero_poster_url}
  jsonLd={structured}
>
  <!-- Patrón estándar de accesibilidad web (A11y) para permitir a los usuarios navegar rápidamente al contenido principal -->
  <a
    href="#main"
    class="sr-only z-50 rounded-md bg-white px-4 py-2 font-semibold text-ink-900 focus:not-sr-only focus:absolute focus:left-4 focus:top-4"
    >Skip to content</a
  >
  <Header config={config} />
  <!-- <Header config={config} overlay={overlay} /> -->
  <main id="main">
    <slot />
  </main>
  <Footer />
</BaseLayout>

---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { ProjectForm } from '../../../components/react/admin/ProjectForm';
import type { ProjectWithMedia } from '../../../lib/types';

const { id } = Astro.params;
if (!id || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) {
  return new Response('Not found', { status: 404 });
}

const [{ data }, { data: services }] = await Promise.all([
  Astro.locals.supabase.from('projects').select('*, project_media(*)').eq('id', id).maybeSingle(),
  Astro.locals.supabase.from('services').select('slug, name').eq('is_published', true).order('sort_order').order('name'),
]);
if (!data) return new Response('Not found', { status: 404 });
const project = data as unknown as ProjectWithMedia;
const serviceOptions: [string, string][] = (services ?? []).map((s) => [s.slug, s.name]);
---

<AdminLayout title="Edit project">
  <ProjectForm client:only="react" initial={project} services={serviceOptions} />
</AdminLayout>

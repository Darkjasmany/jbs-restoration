---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const { data: services, error } = await Astro.locals.supabase
  .from('services')
  .select('id, name, slug, image_url, is_published, is_featured, sort_order')
  .order('sort_order', { ascending: true })
  .order('name', { ascending: true });
---

<AdminLayout title="Services">
  <div class="mb-4 flex justify-end">
    <a href="/admin/services/new" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Add service</a>
  </div>
  {error && <p role="alert" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">Could not load services: {error.message}</p>}
  {
    services && services.length > 0 ? (
      <ul class="divide-y divide-slate-200 rounded-xl bg-white ring-1 ring-slate-200">
        {services.map((s) => (
          <li>
            <a href={`/admin/services/${s.id}`} class="flex items-center gap-4 px-4 py-3 hover:bg-slate-50">
              <span class="w-6 flex-none text-center text-sm tabular-nums text-slate-400">{s.sort_order}</span>
              {s.image_url ? (
                <img src={s.image_url} alt="" width="56" height="42" class="h-11 w-14 flex-none rounded-md object-cover ring-1 ring-slate-200" loading="lazy" />
              ) : (
                <span class="flex h-11 w-14 flex-none items-center justify-center rounded-md bg-slate-100 text-xs text-slate-400 ring-1 ring-slate-200">No photo</span>
              )}
              <span class="min-w-0 flex-1">
                <span class="block truncate font-medium">{s.name}</span>
                <span class="block truncate font-mono text-xs text-slate-500">/services/{s.slug}</span>
              </span>
              <span class="flex flex-none items-center gap-2 text-xs font-medium">
                {s.is_featured && <span class="rounded-full bg-amber-100 px-2 py-1 text-amber-800">Home</span>}
                <span class:list={['rounded-full px-2 py-1', s.is_published ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700']}>
                  {s.is_published ? 'Published' : 'Draft'}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      !error && <p class="rounded-xl bg-white p-6 text-slate-600 ring-1 ring-slate-200">No services yet. Add the first one to build the catalog.</p>
    )
  }
</AdminLayout>

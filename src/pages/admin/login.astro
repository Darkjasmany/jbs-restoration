---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LoginForm } from '../../components/react/admin/LoginForm';

const error = Astro.url.searchParams.get('error') ?? undefined;
---

<BaseLayout title="Sign in | Admin" noindex>
  <main class="grid min-h-screen place-items-center bg-slate-100 p-4">
    <LoginForm client:load initialError={error} />
  </main>
</BaseLayout>

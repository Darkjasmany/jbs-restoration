---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProjectCard from '../../components/astro/ProjectCard.astro';
import CtaBand from '../../components/astro/CtaBand.astro';
import { BeforeAfterSlider } from '../../components/react/public/BeforeAfterSlider';
import { serviceName } from '../../lib/services';
import { coverOf, formatMonthYear, getProjectBySlug, getPublishedProjects, getSiteConfig, placeOf, toSummary } from '../../lib/queries';
import { breadcrumbLd, projectLd } from '../../lib/seo';

const db = Astro.locals.supabase;
const project = await getProjectBySlug(db, Astro.params.slug ?? '');
if (!project) return Astro.rewrite('/404');

const [config, others] = await Promise.all([getSiteConfig(db), getPublishedProjects(db, { service: project.service_type, excludeId: project.id, limit: 3 })]);
const related = others.map(toSummary);
const cover = coverOf(project);
const before = project.project_media.find((m) => m.role === 'before');
const after = project.project_media.find((m) => m.role === 'after');
const gallery = project.project_media.filter((m) => m.role === 'gallery');
const place = placeOf(project);
const facts = [
  ['Service', serviceName(project.service_type)],
  ['Location', place],
  ['Roof material', project.roof_material],
  ['Completed', formatMonthYear(project.completed_on)],
].filter((f): f is [string, string] => !!f[1]);
---

<PublicLayout
  title={project.seo_title ?? `${project.title} | ${config.company_name}`}
  description={project.seo_description ?? project.description?.slice(0, 155) ?? `${serviceName(project.service_type)} project${place ? ` in ${place}` : ''}.`}
  image={cover?.url}
  config={config}
  jsonLd={[
    projectLd(project, Astro.site!),
    breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Projects', path: '/portfolio' }, { name: project.title, path: `/portfolio/${project.slug}` }], Astro.site!),
  ]}
>
  <article class="mx-auto max-w-6xl px-6 py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500"><a href="/portfolio" class="hover:underline">Projects</a></nav>
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight sm:text-5xl">{project.title}</h1>

    {
      cover && (
        <img src={cover.url} alt={cover.alt_text || project.title} width={cover.width ?? 1600} height={cover.height ?? 1000} fetchpriority="high" decoding="async" class="mt-10 max-h-[38rem] w-full rounded-xl object-cover" />
      )
    }

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_18rem]">
      <div>
        {project.description && <p class="max-w-2xl whitespace-pre-line text-lg leading-relaxed text-slate-700">{project.description}</p>}

        {
          before && after && (
            <section class="mt-14" aria-labelledby="before-after">
              <h2 id="before-after" class="mb-4 text-2xl font-bold">Before and after</h2>
              <BeforeAfterSlider client:visible before={{ url: before.url, alt: before.alt_text || `${project.title} before` }} after={{ url: after.url, alt: after.alt_text || `${project.title} after` }} />
            </section>
          )
        }
      </div>

      <dl class="h-fit divide-y divide-slate-200 rounded-2xl bg-slate-50 px-6 py-2 ring-1 ring-slate-200">
        {facts.map(([label, value]) => <div class="py-4"><dt class="text-sm text-slate-500">{label}</dt><dd class="mt-0.5 font-semibold">{value}</dd></div>)}
      </dl>
    </div>

    {
      gallery.length > 0 && (
        <section class="mt-16" aria-labelledby="gallery">
          <h2 id="gallery" class="mb-6 text-2xl font-bold">Project gallery</h2>
          <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
            {gallery.map((m) => (
              <div class="mb-4 break-inside-avoid overflow-hidden rounded-lg bg-slate-200">
                {m.type === 'image' ? (
                  <img src={m.url} alt={m.alt_text || project.title} width={m.width ?? 1200} height={m.height ?? 900} loading="lazy" decoding="async" class="w-full" />
                ) : (
                  <video src={m.url} controls playsinline preload="metadata" class="w-full" aria-label={m.alt_text || `${project.title} video`} />
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="bg-slate-50 py-20">
        <div class="mx-auto max-w-6xl px-6">
          <h2 class="text-2xl font-bold">More {serviceName(project.service_type).toLowerCase()} projects</h2>
          <div class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => <ProjectCard project={p} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand config={config} service={project.service_type} />
</PublicLayout>

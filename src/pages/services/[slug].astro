---
import PublicLayout from "../../layouts/PublicLayout.astro";
import ProjectCard from "../../components/astro/ProjectCard.astro";
import CtaBand from "../../components/astro/CtaBand.astro";
import { getService } from "../../lib/services";
import {
  getPublishedProjects,
  getSiteConfig,
  toSummary,
} from "../../lib/queries";
import { breadcrumbLd, serviceLd } from "../../lib/seo";

const service = getService(Astro.params.slug ?? "");
if (!service) return Astro.rewrite("/404");

const db = Astro.locals.supabase;
const [config, projects] = await Promise.all([
  getSiteConfig(db),
  getPublishedProjects(db, { service: service.slug, limit: 3 }),
]);
const related = projects.map(toSummary);
const tel = config.phone ? `tel:${config.phone.replace(/[^\d+]/g, "")}` : null;
---

<PublicLayout
  title={`${service.name} | ${config.company_name}`}
  description={service.short}
  config={config}
  jsonLd={[
    serviceLd(service, config, Astro.site!),
    breadcrumbLd(
      [
        { name: "Home", path: "/" },
        { name: "Services", path: "/services" },
        { name: service.name, path: `/services/${service.slug}` },
      ],
      Astro.site!,
    ),
  ]}
>
  <section class="mx-auto max-w-6xl px-6 pb-8 pt-16">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <a href="/services" class="hover:underline">Services</a>
    </nav>
    <h1
      class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight sm:text-5xl"
    >
      {service.name}
    </h1>
  </section>

  <div
    class="mx-auto grid max-w-6xl gap-16 px-6 pb-24 lg:grid-cols-[1fr_20rem]"
  >
    <div class="space-y-14">
      <p class="max-w-2xl text-xl leading-relaxed text-slate-700">
        {service.intro}
      </p>

      {
        service.includes.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold">What is included</h2>
            <ul class="mt-5 space-y-3">
              {service.includes.map((item) => (
                <li class="flex gap-3">
                  <span
                    class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full bg-brand-600"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        service.signs.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold">Signs you may need this</h2>
            <ul class="mt-5 space-y-3">
              {service.signs.map((item) => (
                <li class="flex gap-3">
                  <span
                    class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full bg-brand-600"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        related.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold">
              Recent {service.name.toLowerCase()} projects
            </h2>
            <div class="mt-6 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
            <a
              href={`/portfolio?service=${service.slug}`}
              class="mt-8 inline-block font-semibold text-brand-700 underline underline-offset-4"
            >
              See all {service.name.toLowerCase()} projects
            </a>
          </section>
        )
      }

      {
        service.faqs.length > 0 && (
          <section>
            <h2 class="text-2xl font-bold">Common questions</h2>
            <div class="mt-5 divide-y divide-slate-200 border-y border-slate-200">
              {service.faqs.map((faq) => (
                <details class="group py-4">
                  <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
                    {faq.q}
                  </summary>
                  <p class="mt-2 text-slate-600">{faq.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <aside class="lg:sticky lg:top-8 lg:self-start">
      <div class="rounded-2xl bg-slate-50 p-6 ring-1 ring-slate-200">
        <h2 class="text-xl font-bold">Get a free estimate</h2>
        <p class="mt-2 text-slate-600">
          Tell us about your roof and we will schedule an inspection.
        </p>
        <a
          href={`/contact?service=${service.slug}`}
          class="mt-5 block rounded-lg bg-brand-600 px-5 py-3 text-center font-semibold text-white hover:bg-brand-700"
          >{config.hero_cta_label}</a
        >
        {
          tel && (
            <a
              href={tel}
              class="mt-3 block rounded-lg border border-slate-300 px-5 py-3 text-center font-semibold hover:bg-white"
            >
              Call {config.phone}
            </a>
          )
        }
      </div>
    </aside>
  </div>

  <CtaBand config={config} service={service.slug} />
</PublicLayout>

---
import PublicLayout from '../layouts/PublicLayout.astro';
import Hero from '../components/astro/Hero.astro';
import ServicesGrid from '../components/astro/ServicesGrid.astro';
import ProjectCard from '../components/astro/ProjectCard.astro';
import CtaBand from '../components/astro/CtaBand.astro';
import { TestimonialsCarousel } from '../components/react/public/TestimonialsCarousel';
import { getPublishedProjects, getSiteConfig, getTestimonials, toSummary } from '../lib/queries';

const db = Astro.locals.supabase;
const [config, featured, testimonials] = await Promise.all([getSiteConfig(db), getPublishedProjects(db, { featured: true, limit: 5 }), getTestimonials(db, 9)]);
const showcase = (featured.length >= 3 ? featured : await getPublishedProjects(db, { limit: 5 })).map(toSummary);

const steps = [
  { title: 'Inspection', text: 'We check the roof, the attic and the surrounding areas to find the real cause of the problem.' },
  { title: 'Written estimate', text: 'You get the scope, materials and price in writing before any work starts.' },
  { title: 'The work', text: 'We protect your property, complete the job and keep you updated along the way.' },
  { title: 'Final walkthrough', text: 'We clean up, review the details together and answer your questions.' },
];
---

<PublicLayout
  title={`${config.company_name} | Roof Repair, Replacement & Storm Damage`}
  description={config.hero_subtitle ?? `${config.company_name} repairs and replaces roofs and restores storm damage. Request a free estimate.`}
  config={config}
  overlay
>
  <Hero config={config} />

  <section class="mx-auto grid max-w-6xl gap-12 px-6 py-24 lg:grid-cols-[1fr_1.6fr]">
    <div class="lg:sticky lg:top-8 lg:self-start">
      <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">Every roof problem, one crew.</h2>
      <p class="mt-4 max-w-md text-lg text-slate-600">From a single leak to a complete replacement, we handle the roof and the details around it.</p>
      <a href="/services" class="mt-6 inline-block font-semibold text-brand-700 underline underline-offset-4">All services</a>
    </div>
    <ServicesGrid />
  </section>

  {
    showcase.length > 0 && (
      <section class="bg-slate-50 py-24">
        <div class="mx-auto max-w-6xl px-6">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">Recent work</h2>
            <a href="/portfolio" class="font-semibold text-brand-700 underline underline-offset-4">See all projects</a>
          </div>
          <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {showcase.map((project, i) => <ProjectCard project={project} wide={i === 0} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-6 py-24">
    <h2 class="max-w-2xl text-3xl font-extrabold leading-tight sm:text-4xl">What happens after you call.</h2>
    <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li>
            <span class="block text-5xl font-extrabold text-brand-600/25 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 text-lg font-bold">{step.title}</h3>
            <p class="mt-2 text-slate-600">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {
    testimonials.length > 0 && (
      <section class="bg-slate-50 py-24">
        <div class="mx-auto max-w-6xl px-6">
          <h2 class="max-w-2xl text-3xl font-extrabold leading-tight sm:text-4xl">What homeowners say.</h2>
          <div class="mt-10">
            <TestimonialsCarousel client:visible testimonials={testimonials.map(({ id, author_name, author_city, rating, content }) => ({ id, author_name, author_city, rating, content }))} />
          </div>
        </div>
      </section>
    )
  }

  <CtaBand config={config} />
</PublicLayout>
